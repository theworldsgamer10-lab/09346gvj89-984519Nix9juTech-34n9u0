# Copy to .env for local runs. In CI these live in GitHub Secrets, not here.
# .env is gitignored.

# --- required -------------------------------------------------------------
LLM_PROVIDER=groq
LLM_API_KEY=
VIDEO_SOURCE=pexels
PEXELS_API_KEY=

# --- optional -------------------------------------------------------------
PIXABAY_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
VOICE_NAME=en-US-AndrewNeural
AUTO_PUBLISH=false

# --- YouTube (only for hands-off publishing) ------------------------------
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
YT_PRIVACY=private

# --- failure alerts -------------------------------------------------------
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
